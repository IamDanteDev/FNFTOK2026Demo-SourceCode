; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Friday Night Funkin': The Origami King DEMO"
run/main_scene="res://scenes/states/menus/title_screen/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=160
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://doew30iqtnqcc"
config/icon="res://icon-11.png"
run/name="Friday Night Funkin': The Origami King"

[autoload]

Main="*res://scripts/singletons/main.gd"
Settings="*res://scripts/singletons/settings.gd"
Conductor="*res://scripts/singletons/conductor.gd"
Debug="*res://scripts/singletons/debug.gd"
Weeks="*res://scripts/singletons/weeks.gd"
Event="*res://scripts/singletons/event.gd"
SaveData="*res://scripts/resources/save_data.gd"
PhantomCameraManager="*uid://csf8242fsjuxu"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[editor_plugins]

enabled=PackedStringArray("res://addons/2d_shapes/plugin.cfg")

